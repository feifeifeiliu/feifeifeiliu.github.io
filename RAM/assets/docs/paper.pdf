dup 43 /plus put
dup 115 /s put
dup 59 /semicolon put
dup 55 /seven put
dup 54 /six put
dup 51 /three put
dup 126 /tilde put
dup 50 /two put
dup 120 /x put
dup 48 /zero put
readonly def
currentdict end
currentfile eexec
